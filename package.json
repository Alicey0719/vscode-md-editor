{
  "name": "md-editor",
  "displayName": "mdEditor",
  "description": "Google Docs-like WYSIWYG editor for Markdown files, with paste-to-save image handling.",
  "version": "0.1.0",
  "publisher": "alicey",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alicey0719/vscode-md-editor.git"
  },
  "bugs": {
    "url": "https://github.com/Alicey0719/vscode-md-editor/issues"
  },
  "homepage": "https://github.com/Alicey0719/vscode-md-editor#readme",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "This extension writes image files to the workspace, so it only runs in trusted workspaces."
    }
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "mdEditor.wysiwyg",
        "displayName": "mdEditor",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "mdEditor.openHere",
        "title": "Open in mdEditor",
        "category": "mdEditor"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "when": "resourceExtname == .md",
          "command": "mdEditor.openHere",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "when": "resourceExtname == .md",
          "command": "mdEditor.openHere",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "build:prod": "NODE_ENV=production node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc -p . --noEmit && tsc -p webview --noEmit",
    "package": "npm run typecheck && npm run build:prod && vsce package",
    "publish": "npm run typecheck && npm run build:prod && vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "3.5.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@fontsource/line-seed-jp": "5.3.0",
    "@milkdown/core": "^7.5.0",
    "@milkdown/crepe": "^7.5.0",
    "@milkdown/ctx": "^7.5.0",
    "@milkdown/plugin-listener": "^7.5.0",
    "@milkdown/preset-commonmark": "^7.5.0",
    "@milkdown/preset-gfm": "^7.5.0",
    "@milkdown/prose": "^7.5.0",
    "@milkdown/theme-nord": "^7.5.0"
  }
}
