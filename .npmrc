# Supply-chain hardening: refuse packages published within the last N.
# Requires npm >= 11.5. On older npm this line is ignored.
# age in days (npm source: `Date.now() - 86400000 * age`)
min-release-age=7

# Reproducible installs
save-exact=true
package-lock=true

# Do not run arbitrary lifecycle scripts on install.
# We re-enable per-package as needed.
ignore-scripts=true

# Prefer the offline cache before hitting the registry.
prefer-offline=true

# Fail loudly rather than silently install a package with reported vulns >= high.
audit-level=high
